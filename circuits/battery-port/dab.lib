* Single battery port. P, N are the battery rail. H, L are the DC-link rail.
* D is signed phase shift as a fraction of HALF a switching period.
* Positive D = discharge into the link. Stiff external DC rails are required.
.subckt DAB P N H L params: D=0.16 FSW=50k NSEC=14 LK=1.5u LM=180u RP=3m RLO=1m RHI=35m DT=120n STOP=1e9
.param TPER={1/FSW} EDGE=25n
.param TPRI={max(-D,0)*TPER/2} TSEC={max(D,0)*TPER/2}

* Isolated ideal gate commands, with both diagonals off during dead time.
VPA rawpa N PULSE(0 5 {TPRI+DT/2} {EDGE} {EDGE} {TPER/2-DT-EDGE} {TPER})
VPB rawpb N PULSE(0 5 {TPRI+TPER/2+DT/2} {EDGE} {EDGE} {TPER/2-DT-EDGE} {TPER})
VSA rawsa L PULSE(0 5 {TSEC+DT/2} {EDGE} {EDGE} {TPER/2-DT-EDGE} {TPER})
VSB rawsb L PULSE(0 5 {TSEC+TPER/2+DT/2} {EDGE} {EDGE} {TPER/2-DT-EDGE} {TPER})
* Command inhibition only. Body diodes remain present when both bridges stop.
Ben en N V={max(0,min(1,(STOP-time)/EDGE))}
Bpa cpa N V={v(rawpa,N)*v(en,N)}
Bpb cpb N V={v(rawpb,N)*v(en,N)}
Bsa csa L V={v(rawsa,L)*v(en,N)}
Bsb csb L V={v(rawsb,L)*v(en,N)}

* Primary bridge and freewheel paths
BP1 P a I={v(P,a)*(1e-8+v(cpa,N)/(5*RLO))}
BP2 a N I={v(a,N)*(1e-8+v(cpb,N)/(5*RLO))}
BP3 P b I={v(P,b)*(1e-8+v(cpb,N)/(5*RLO))}
BP4 b N I={v(b,N)*(1e-8+v(cpa,N)/(5*RLO))}
BDP1 a P I={max(0,v(a,P)-0.75)/0.008}
BDP2 N a I={max(0,v(N,a)-0.75)/0.008}
BDP3 b P I={max(0,v(b,P)-0.75)/0.008}
BDP4 N b I={max(0,v(N,b)-0.75)/0.008}
Ca a N 1n
Cb b N 1n

* Transformer: explicit primary-referred transfer inductance and resistance.
* Voltage source EX and reflected current source FX form an ideal transformer.
Ltransfer a lr {LK}
Rprimary lr wp {RP}
Lmag wp b {LM}
EX sx d wp b {NSEC}
VsecCurrent sx c 0
FX wp b VsecCurrent {NSEC}

* Secondary bridge and freewheel paths
BS1 H c I={v(H,c)*(1e-8+v(csa,L)/(5*RHI))}
BS2 c L I={v(c,L)*(1e-8+v(csb,L)/(5*RHI))}
BS3 H d I={v(H,d)*(1e-8+v(csb,L)/(5*RHI))}
BS4 d L I={v(d,L)*(1e-8+v(csa,L)/(5*RHI))}
BDS1 c H I={max(0,v(c,H)-0.75)/0.008}
BDS2 L c I={max(0,v(L,c)-0.75)/0.008}
BDS3 d H I={max(0,v(d,H)-0.75)/0.008}
BDS4 L d I={max(0,v(L,d)-0.75)/0.008}
Cc c L 100p
Cd d L 100p
.ends DAB
